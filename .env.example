# Supabase project settings. Never commit real secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only. Do not prefix with VITE_ and never expose in browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional public contact details; replace before launch.
VITE_SITE_EMAIL=hello@oneo.example
VITE_SITE_INSTAGRAM=https://instagram.com/
